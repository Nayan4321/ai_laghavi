# Hostinger runs LiteSpeed, which reads these Apache rules.
Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Force HTTPS (enable the free SSL in hPanel first).
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
  # Code, data and tooling are never served directly.
  RewriteRule ^(app|storage|cron|cli|tests|\.git|\.github)(/|$) - [F,L]
</IfModule>

<FilesMatch "^(config\.php|config\.example\.php|schema\.sql|.*\.md|\.gitignore|\.user\.ini)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
